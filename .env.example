# Choose one 50-item assignment. Omit to show all 100 samples.
# ANNOTATOR_SAMPLE_FILE=assignments/A.jsonl
# ANNOTATOR_SAMPLE_FILE=assignments/B.jsonl

# Where single-label reviews are saved.
# ANNOTATOR_REVIEW_STORE_PATH=/data/trajectory_label_reviews.jsonl

# Optional full raw trajectory root.
# SWE_TRAJECTORY_ROOT=/path/to/trajectories/swebench_verified

# Optional replacement compact dataset directory.
# ANNOTATOR_DATA_DIR=/data/annotator_dataset
